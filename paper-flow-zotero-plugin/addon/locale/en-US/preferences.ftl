pref-title = Paper Flow Settings
pref-intro = Paper Flow syncs Zotero papers to Notion directly and uses your local AI CLI to generate reading guides.
pref-notero-note = Paper Flow manages its own Notion sync settings; install a local Codex or Claude CLI before using it.
pref-section-workflow = Automatic processing
pref-section-advanced = Advanced
pref-section-actions = Actions
pref-section-status = Status
pref-enabled =
    .label = Enable Paper Flow plugin
pref-auto-sync =
    .label = Automatically process new or updated Zotero items while Zotero is running
pref-show-notifications =
    .label = Show progress popups for automatic and manual runs
pref-skip-unchanged =
    .label = Skip auto-processing when an item's content has not changed (avoids re-runs on sync metadata write-backs)
pref-use-custom-commands =
    .label = Use custom command templates instead of managed runtime and AI settings
pref-managed-note = Controls when items are handed to the AI automatically.
pref-watched-collection = Only process items from this collection (leave empty for all)
pref-debounce-seconds = Wait this many seconds after a Zotero change before launching the command
pref-process-timeout = Stop the command if it runs longer than this many seconds
pref-section-ai = AI CLI
pref-section-ai-desc = Which local CLI generates the guide, and where it runs.
pref-section-prompt = Reading-guide prompt
pref-execution-mode = Runtime
