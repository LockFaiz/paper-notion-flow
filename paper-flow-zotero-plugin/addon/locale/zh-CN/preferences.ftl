pref-title = Paper Flow 设置
pref-intro = Paper Flow 直接把 Zotero 文献同步到 Notion，并调用本地 AI CLI 生成阅读指导。
pref-notero-note = Paper Flow 自己管理 Notion 同步配置；只需要提前安装本地 Codex 或 Claude CLI。
pref-section-workflow = 自动处理
pref-section-advanced = 高级设置
pref-section-actions = 操作
pref-section-status = 状态与诊断
pref-enabled =
    .label = 启用 Paper Flow 插件
pref-auto-sync =
    .label = Zotero 运行时自动处理新增或更新的条目
pref-show-notifications =
    .label = 显示自动运行和手动运行的提示弹窗
pref-skip-unchanged =
    .label = 条目内容没有变化时跳过自动处理（避免同步元数据回写导致的重复解读）
pref-use-custom-commands =
    .label = 使用自定义命令模板，而不是插件托管的运行环境和 AI 配置
pref-managed-note = 控制何时自动把文献交给 AI 处理。
pref-watched-collection = 仅处理这个 collection 下的条目（留空表示全部）
pref-debounce-seconds = Zotero 条目变化后延迟多少秒再触发命令
pref-process-timeout = 命令运行超过这么多秒后自动终止
pref-section-ai = AI CLI
pref-section-ai-desc = 选择由哪个本地 CLI 生成解读,以及它在哪个环境运行。
pref-section-prompt = 论文解读 Prompt
pref-execution-mode = 运行环境
pref-wsl-distro = WSL 发行版名称（仅 Windows WSL）
pref-guide-language = 输出语言(页面标题与默认 prompt)
pref-workspace-path = paper-notion-flow 的工作区路径
pref-notion-token = Notion 集成 Token
pref-notion-database-id = Notion 数据库 ID
pref-ai-tool = AI 工具
pref-ai-args = AI CLI 参数
pref-ai-model = 模型(留空 = CLI 默认)
pref-ai-effort = 推理强度(留空 = 默认)
pref-ai-extra-args = 额外 AI CLI 参数
pref-auto-update-cli =
    .label = 自动保持所选 CLI 为最新(每天检查一次,后台更新)
pref-update-cli = 立即更新 CLI
pref-check-ai = 检查 Paper Flow 环境
pref-command-help = 高级自定义命令模板。支持占位符：{{key}}、{{title}}、{{collection}}、{{promptFile}}（当前运行环境路径）、{{promptFileWindows}}（Windows 路径）。
pref-delete-command-help = 高级自定义命令模板，用于把 Zotero 中已删除的条目同步回 Notion。
pref-prompt-help = 可选的阅读指导自定义 prompt。留空则使用内置默认 prompt。这里的自定义内容保存在 Zotero 偏好设置中，插件升级后不会丢失。
pref-prompt-presets-label = 已存 prompt 预设
pref-prompt-presets-help = 最多保存 10 条;★ 为默认,每次启动自动套用。
pref-save-preset = 保存当前为预设
pref-set-default-preset = 设为默认
pref-delete-preset = 删除选中
pref-fill-default-prompt = 填入默认 prompt
pref-clear-custom-prompt = 清空自定义 prompt
pref-actions-note = 可以先用这些按钮验证当前配置，再开启完整自动化。
pref-run-selected = 立即处理当前选中文献
pref-prune-deleted = 立即同步已删除条目
pref-copy-example = 复制当前命令
pref-copy-status = 复制诊断信息
pref-help = { $name } Build { $version } { $time }
pref-refresh-models = 刷新模型列表
pref-runtime-auto =
    .label = 自动
pref-runtime-native =
    .label = 本机 shell
pref-runtime-wsl =
    .label = WSL
pref-use-selected-collection = 使用当前选中的收藏夹
pref-clear-watched-collection = 清除收藏夹过滤
pref-sync-notes =
    .label = 同步 Zotero 笔记到 Notion 子页面
pref-archive-preview =
    .label = 清理已删除条目前先预览
